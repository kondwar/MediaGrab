# Copy these NAMES into your hosting platform's Environment Variables.
# Never commit real values to GitHub.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=https://mediagrab.syria.blitz.cloud/
TELEGRAM_INITDATA_MAX_AGE=86400

# --- Admin dashboard (disabled while ADMIN_PASSWORD is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Adsgram (optional; OFF by default) ---
ADSGRAM_ENABLED=false
ADSGRAM_BLOCK_ID=
# "allow": continue to the download if the ad cannot be shown
# "block": stop and show an error
ADSGRAM_FAIL_MODE=allow
ADSGRAM_SDK_URL=

# --- Database ---
DATABASE_URL=sqlite:///data/mediagrab.db

# --- Download limits ---
MAX_CONCURRENT_DOWNLOADS=2
# 0 = no limit
MAX_FILESIZE_MB=0
